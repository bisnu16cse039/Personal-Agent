# Personal Assistant Agent - Environment Configuration Template
# Copy this file to .env and fill in values before running the agent
# All variables are required unless marked [OPTIONAL]

# ==============================================================================
# LOCAL MODEL INFERENCE (Ollama)
# ==============================================================================

# Ollama server endpoint (local machine)
OLLAMA_BASE_URL=http://localhost:11434

# Primary reasoning model - must be pulled locally via: ollama pull qwen3:14b
PRIMARY_MODEL=qwen3:14b

# Embedding model for ChromaDB - must be pulled via: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Model inference parameters
# Temperature: 0.0 (deterministic) to 1.0 (creative)
# For reasoning: use 0.7; for factual Q&A: use 0.3
MODEL_TEMPERATURE=0.7

# Maximum tokens to generate per LLM call
MODEL_MAX_TOKENS=2048

# ==============================================================================
# LANGSMITH TRACING [OPTIONAL]
# ==============================================================================

# Enable LangSmith observability (Phase 2+)
# Set to 'true' only after dependencies are installed and Ollama is verified
LANGSMITH_ENABLED=false

# LangSmith API key (leave blank for offline mode)
# Sign up at: https://smith.langchain.com
# Public models API: https://docs.smith.langchain.com
LANGSMITH_API_KEY=

# LangSmith project name for this agent's traces
LANGSMITH_PROJECT=personal-agent-phase1

# ==============================================================================
# VECTOR DATABASE (ChromaDB)
# ==============================================================================

# Path to persist ChromaDB vector store
# Stores long-term memory (facts, preferences, past interactions)
CHROMADB_PATH=./data/chroma_db

# ==============================================================================
# PERSISTENCE (SQLite Checkpointer)
# ==============================================================================

# Path to SQLite database for conversation checkpoints
# Stores conversation history across sessions
SQLITE_CHECKPOINT_PATH=./data/conversation_history.db

# ==============================================================================
# USER CONTEXT
# ==============================================================================

# Default user ID for personalization and audit trails
DEFAULT_USER_ID=user_001

# ==============================================================================
# WEB SEARCH (Phase 4+)
# ==============================================================================

# Enable DuckDuckGo web search when model indicates knowledge gap
ENABLE_WEB_SEARCH=true

# Maximum web results to retrieve per search
WEB_SEARCH_MAX_RESULTS=5

# ==============================================================================
# AGENT EVALUATION [OPTIONAL]
# ==============================================================================

# Enable LLM-as-judge evaluation (Phase 6+)
ENABLE_EVALUATION=false

# Directory to log evaluation results
EVALUATION_LOG_PATH=./data/evaluation_logs

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (leave blank for stdout only)
LOG_FILE_PATH=./logs/agent.log

# ==============================================================================
# CHAINLIT UI (Phase 6)
# ==============================================================================

# Chainlit server host and port
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Enable production mode (disable debug logging)
CHAINLIT_DEBUG=false
